{
  "version": "0.2.0",
  "configurations": [{
    "type": "node", "request": "launch", "name": "Abrir site FitDance",
    "program": "${workspaceFolder}/server.js",
    "runtimeArgs": ["--env-file-if-exists=.env"],
    "cwd": "${workspaceFolder}",
    "console": "integratedTerminal",
    "serverReadyAction": { "pattern": "Site disponível em (https?://[^\\s]+)", "uriFormat": "%s", "action": "openExternally" }
  }]
}
