    "build:vendor": "node scripts/build-vendor.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0"
  }
}
