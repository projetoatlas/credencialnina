{
  "name": "aulao-fitdance-credenciais",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de aulão de aniversário com credenciais e integração Google Planilhas",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
